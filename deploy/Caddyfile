{
  servers {
    # Only Cloudflare's published ranges may supply CF-Connecting-IP.
    trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
    client_ip_headers CF-Connecting-IP
  }
}

{$DOMAIN} {
  encode zstd gzip
  header {
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
    Strict-Transport-Security "max-age=31536000"
    -Server
  }
  # Clerk's Frontend API through this host, so production sign-in works on a
  # hostname where its CNAME records cannot be created.
  handle_path /__clerk/* {
    reverse_proxy https://frontend-api.clerk.dev {
      header_up Host frontend-api.clerk.dev
      header_up Clerk-Proxy-Url https://{$DOMAIN}/__clerk
      header_up Clerk-Secret-Key {$CLERK_SECRET_KEY}
      header_up X-Forwarded-For {client_ip}
      # Clerk answers some requests with a redirect to its own root-relative
      # path, which only exists under this prefix.
      header_down Location "^/v1/" "/__clerk/v1/"
    }
  }
  handle {
    reverse_proxy app:8000 {
      header_up X-Real-IP {client_ip}
    }
  }
}
