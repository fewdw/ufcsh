DOMAIN=ufc.sh
# The permanent administrator: the verified email on the Clerk account that can
# always open /admin. It cannot be removed from inside the panel, which is what
# makes locking yourself out impossible. Everyone else is added there.
DEFAULT_ADMIN=
# Machine credential for /api/status and /api/metrics only — never the panel.
# Generate a private random value; never include it in frontend build variables.
ADMIN_TOKEN=
API_WORKERS=2
# Clerk: only the publishable key is exposed to the frontend.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_AUTHORIZED_PARTIES=https://ufc.sh
