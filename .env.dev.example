# Copy this to .env.dev and keep it private. Use keys from a separate Clerk
# Development instance; do not reuse production keys or .env production values.
DEV_DEFAULT_ADMIN=you@example.com
DEV_ADMIN_TOKEN=replace-with-a-long-random-secret
DEV_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
DEV_CLERK_SECRET_KEY=sk_test_replace_me
DEV_TUNNEL_TOKEN=replace-with-cloudflare-tunnel-token
DEV_API_WORKERS=1
# Set to 1 only when you intentionally want to pause background data syncing.
DEV_NO_SYNC=0
