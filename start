#!/usr/bin/env bash
set -euo pipefail

# Resolve paths relative to this file, even when invoked from another directory.
cd -- "$(dirname -- "${BASH_SOURCE[0]}")"

if ! command -v node >/dev/null 2>&1 || ! command -v npm >/dev/null 2>&1; then
  echo "Node.js 26 and npm are required. Install them, then run ./start again." >&2
  exit 1
fi
if ! node -e 'process.exit(Number(process.versions.node.split(".")[0]) >= 26 ? 0 : 1)'; then
  echo "Node.js 26 or newer is required; found $(node --version)." >&2
  exit 1
fi

export HOST="${HOST:-0.0.0.0}"
export PORT="${PORT:-8000}"
# This launcher always uses local mode. Production has its own supervisor.
export NODE_ENV=development
export API_WORKERS=0
export SYNC_MODE=inline
unset DB_INIT

if ! [[ "$PORT" =~ ^[0-9]+$ ]] || (( PORT < 1 || PORT > 65535 )); then
  echo "PORT must be a number between 1 and 65535." >&2
  exit 1
fi

# Restart cleanly: whatever is already listening on this port — a previous
# ./start, most likely — gets stopped first instead of making this run fail.
if command -v lsof >/dev/null 2>&1; then
  existing="$(lsof -tiTCP:"$PORT" -sTCP:LISTEN 2>/dev/null || true)"
  if [[ -n "$existing" ]]; then
    echo "Stopping the server already running on port ${PORT}…"
    kill $existing 2>/dev/null || true
    for _ in $(seq 1 40); do
      [[ -n "$(lsof -tiTCP:"$PORT" -sTCP:LISTEN 2>/dev/null || true)" ]] || break
      sleep 0.25
    done
    still="$(lsof -tiTCP:"$PORT" -sTCP:LISTEN 2>/dev/null || true)"
    if [[ -n "$still" ]]; then
      kill -9 $still 2>/dev/null || true
      sleep 0.5
    fi
  fi
fi

for project in server client; do
  installed="$project/node_modules/.package-lock.json"
  if [[ ! -f "$installed" || "$project/package-lock.json" -nt "$installed" || "$project/package.json" -nt "$installed" ]]; then
    echo "Installing $project dependencies…"
    npm ci --include=dev --prefix "$project"
  fi
done

# Always build so changed or deleted source files cannot leave a stale frontend.
echo "Building the app…"
NODE_ENV=production npm run build --prefix client

echo
echo "Starting UFC.sh…"
echo "  http://localhost:$PORT"
if [[ "$HOST" == "0.0.0.0" || "$HOST" == "::" ]]; then
  # Bound to every interface: point out the LAN address(es) too, since that's
  # what a phone or other device on the same network needs to connect to.
  node -e '
    const nets = require("node:os").networkInterfaces();
    for (const addrs of Object.values(nets)) {
      for (const addr of addrs ?? []) {
        if (addr.family === "IPv4" && !addr.internal) {
          console.log(`  http://${addr.address}:${process.env.PORT}  (on your network)`);
        }
      }
    }
  '
fi
echo "Press Ctrl+C to stop."
echo
exec node server/src/index.ts
